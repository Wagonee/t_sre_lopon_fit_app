resolver ${NGINX_RESOLVER} valid=5s ipv6=off;
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
log_format json escape=json '{"time":"$time_iso8601","remote_addr":"$remote_addr","request_id":"$request_id","method":"$request_method","uri":"$uri","status":$status,"bytes":$body_bytes_sent,"request_time":$request_time,"upstream":"$upstream_addr","upstream_time":"$upstream_response_time","user_agent":"$http_user_agent"}';

map "$scheme:$http_host" $forwarded_port {
    "~:(?<port>[0-9]+)$" $port;
    "~^https:" 443;
    default 80;
}

upstream backend {
    zone backend 64k;
    server ${BACKEND_HOST}:${BACKEND_PORT} resolve;
    keepalive 16;
}

server {
    listen ${PORT};
    server_tokens off;
    root /usr/share/nginx/html;
    client_max_body_size ${NGINX_MAX_BODY_SIZE};
    access_log /dev/stdout json;
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /api/auth/login {
        limit_req zone=auth burst=5 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/proxy.conf;
    }

    location = /api/auth/register {
        limit_req zone=auth burst=5 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/proxy.conf;
    }

    location /api/ {
        include /etc/nginx/snippets/proxy.conf;
    }

    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        try_files $uri /index.html;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }
}
